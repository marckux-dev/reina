---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

interface Props {
  /** Ciudad tal y como aparece en el frontmatter de los trabajos (ej. "Benidorm"). */
  city: string;
  /** Slug del servicio para filtrar (por defecto, pulido y cristalizado). */
  service?: string;
  title?: string;
}

const {
  city,
  service = "pulido-cristalizado-superficies",
  title = `Trabajos de pulido realizados en ${city}`,
} = Astro.props;

const trabajos = (await getCollection("trabajos"))
  .filter((t) => t.data.city === city && t.data.service === service)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const images = import.meta.glob<ImageMetadata>(
  "../assets/images/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true, import: "default" },
);
function resolveCover(src: string): ImageMetadata | undefined {
  const s = src.startsWith("/") ? src.slice(1) : src;
  return images[`../assets/images/${s}`];
}
---

{
  trabajos.length > 0 && (
    <section class="container mx-auto px-4 py-10">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-6">{title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {trabajos.map((trabajo) => {
          const cover = resolveCover(trabajo.data.coverImage.src);
          return (
            <a
              href={`/trabajos/${trabajo.slug}/`}
              class="relative overflow-hidden w-full rounded-xl shadow-sm h-40 lg:h-48 group cursor-pointer block"
            >
              {cover && (
                <Image
                  src={cover}
                  alt={trabajo.data.coverImage.alt}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 640px) 100vw, 33vw"
                  quality={65}
                  format="webp"
                  loading="lazy"
                  class="kenburns w-full h-full object-cover"
                />
              )}
              <div class="absolute inset-0 bg-black/60 group-hover:bg-black/20 transition-colors duration-700" />
              <div class="absolute inset-0 p-4 flex flex-col justify-end">
                <h3 class="text-gray-100 font-bold text-sm">{trabajo.data.h1}</h3>
                <p class="text-gray-300 text-xs">
                  {trabajo.data.location
                    ? `${trabajo.data.location} · ${trabajo.data.city}`
                    : trabajo.data.city}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )
}
