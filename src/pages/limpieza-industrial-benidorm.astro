---
import type { ImageMetadata } from "astro";
import MainLayout from "../layouts/MainLayout.astro";
import HeroService from "../components/HeroService.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TrabajosCiudad from "../components/TrabajosCiudad.astro";
import FaqService from "../components/FaqService.astro";
import ContactButton from "../components/ContactButton.astro";

const siteUrl = "https://reinamultiservicios.es";
const pageUrl = `${siteUrl}/limpieza-industrial-benidorm/`;
const title = "Limpieza Industrial en Benidorm | Hoteles y Naves";
const description =
  "Limpieza industrial en Benidorm para hoteles y naves: moquetas técnicas, techos y superficies de difícil mantenimiento. Conoce trabajos reales y pide presupuesto.";
const h1 = "Limpieza Industrial en Benidorm";
const subtitle =
  "Limpiezas técnicas en hoteles y naves, con maquinaria y procesos adecuados a cada superficie.";
const heroImage = "techo-despues-limpieza-presion-benidorm.webp";
const imagesMap = import.meta.glob<ImageMetadata>(
  "../assets/images/*.{png,jpg,jpeg,webp,avif}",
  { eager: true, import: "default" },
);
const heroImageMeta = imagesMap[`../assets/images/${heroImage}`];

const faqs = [
  {
    question: "¿Qué tipo de limpieza industrial realizáis en Benidorm?",
    answer:
      "Hemos realizado limpiezas técnicas en hoteles y naves de Benidorm, entre ellas limpieza profunda de moquetas vinílicas y limpieza a presión de un techo industrial. El método se adapta al material y al estado de cada superficie.",
  },
  {
    question: "¿Podéis trabajar en un hotel que sigue abierto?",
    answer:
      "Planificamos la intervención con el responsable del hotel para tratar las zonas por fases y reducir las molestias a huéspedes y personal. El alcance y los horarios se acuerdan para cada trabajo.",
  },
  {
    question: "¿Cómo se prepara un presupuesto?",
    answer:
      "Necesitamos conocer la superficie, el material, su estado y las condiciones de acceso. Con esos datos podemos proponer el procedimiento y preparar un presupuesto ajustado al trabajo.",
  },
];
---

<MainLayout title={title} description={description} ogImage={heroImageMeta?.src} monolingual>
  <main>
    <HeroService title={h1} subtitle={subtitle} image={heroImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        "name": h1,
        "serviceType": "Limpieza industrial",
        "description": description,
        "provider": {
          "@type": "LocalBusiness",
          "@id": `${siteUrl}/#localbusiness`,
        },
        "areaServed": {
          "@type": "City",
          "name": "Benidorm",
          "containedInPlace": { "@type": "AdministrativeArea", "name": "Alicante" },
        },
        "url": pageUrl,
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/` },
          { "@type": "ListItem", "position": 2, "name": "Servicios", "item": `${siteUrl}/servicios/` },
          { "@type": "ListItem", "position": 3, "name": h1, "item": pageUrl },
        ],
      })}
    />

    <Breadcrumb crumbs={[
      { name: "Inicio", href: "/" },
      { name: "Servicios", href: "/servicios/" },
      { name: h1 },
    ]} />

    <div class="service-content trabajo-content">
      <p>
        Nuestro servicio de <strong>limpieza industrial en Benidorm</strong> se
        dirige a instalaciones que necesitan algo más que una limpieza cotidiana.
        Trabajamos en hoteles y naves con superficies extensas o materiales que
        requieren maquinaria, productos y procedimientos específicos. Antes de
        actuar valoramos el material, la suciedad y las condiciones de acceso.
      </p>

      <h2>Limpieza de moquetas técnicas en hoteles</h2>
      <p>
        En el <a href="/trabajos/limpieza-moqueta-hotel-benidorm/">MedPlaya Hotel
        Río Park</a> limpiamos moquetas murales de PVC trenzado en pasillos y zonas
        de paso. Era importante eliminar la suciedad incrustada sin perjudicar el
        material ni prolongar innecesariamente el tiempo de secado. La limpieza de
        superficies en un hotel se organiza teniendo en cuenta la circulación de
        huéspedes y el uso de cada espacio.
      </p>

      <h2>Limpieza a presión en naves</h2>
      <p>
        También hemos realizado la <a href="/trabajos/limpieza-agua-a-presion-techo-nave-benidorm/">limpieza
        a presión del techo de una nave en Benidorm</a>. La intervención permitió
        retirar humedad, moho y depósitos acumulados en una zona donde los métodos
        habituales de limpieza no resultaban adecuados. La técnica se selecciona
        según la superficie y el tipo de residuo, para trabajar de forma controlada.
      </p>

      <h2>Intervenciones puntuales y mantenimiento</h2>
      <p>
        Podemos actuar sobre una zona concreta o estudiar un plan de limpieza
        periódica para instalaciones con tránsito intenso. Cada propuesta parte de
        las necesidades reales del inmueble: superficie, material, acceso y
        disponibilidad de las zonas de trabajo. Atendemos Benidorm desde nuestra
        base en La Nucía y prestamos servicio en el resto de la Costa Blanca.
      </p>

      <div class="not-prose my-8 flex justify-center">
        <ContactButton link="/contacto/" text="Pedir presupuesto de limpieza industrial" />
      </div>
    </div>

    <TrabajosCiudad
      city="Benidorm"
      service="limpieza-industrial"
      title="Trabajos de limpieza industrial en Benidorm"
    />

    <section class="service-content">
      <p>
        Conoce todos nuestros <a href="/servicios/limpieza-industrial/">servicios
        de limpieza industrial</a>. Para fachadas y grandes superficies de vidrio,
        consulta la <a href="/limpieza-cristales-benidorm/">limpieza de cristales
        en Benidorm</a>; también realizamos
        <a href="/pulido-suelos-benidorm/">pulido de suelos en Benidorm</a>.
      </p>
    </section>

    <FaqService faqs={faqs} title="Preguntas frecuentes sobre limpieza industrial en Benidorm" />
  </main>
</MainLayout>
