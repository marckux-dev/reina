---
import type { ImageMetadata } from "astro";
import MainLayout from "../layouts/MainLayout.astro";
import HeroService from "../components/HeroService.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TrabajosCiudad from "../components/TrabajosCiudad.astro";
import FaqService from "../components/FaqService.astro";
import ContactButton from "../components/ContactButton.astro";

const siteUrl = "https://reinamultiservicios.es";
const pageUrl = `${siteUrl}/limpieza-cristales-benidorm/`;
const title = "Limpieza de Cristales en Benidorm | Fachadas y Hoteles";
const description =
  "Limpieza profesional de cristales en Benidorm para hoteles y edificios: fachadas acristaladas, zonas de difícil acceso y mantenimiento periódico.";
const h1 = "Limpieza de Cristales en Benidorm";
const subtitle =
  "Fachadas de hoteles, grandes cristaleras y espacios de difícil acceso con equipos adaptados a cada edificio.";
const heroImage = "fachada-hotel-limpieza-cristales.webp";
const imagesMap = import.meta.glob<ImageMetadata>(
  "../assets/images/*.{png,jpg,jpeg,webp,avif}",
  { eager: true, import: "default" },
);
const heroImageMeta = imagesMap[`../assets/images/${heroImage}`];

const faqs = [
  {
    question: "¿Limpiáis fachadas acristaladas de hoteles en Benidorm?",
    answer:
      "Sí. Hemos trabajado en fachadas, lucernarios y zonas panorámicas de hoteles de Benidorm. Evaluamos el acceso y organizamos la intervención para interferir lo menos posible con la actividad del edificio.",
  },
  {
    question: "¿Podéis acceder a cristales en altura o en interiores difíciles?",
    answer:
      "Disponemos de plataformas elevadoras y grúa araña para zonas de acceso complejo, como fachadas y atrios. Elegimos el equipo después de revisar las condiciones de cada espacio.",
  },
  {
    question: "¿Ofrecéis limpieza periódica de cristales?",
    answer:
      "Sí. Podemos planificar el mantenimiento de cristaleras y fachadas según el uso del edificio y la frecuencia que necesite el cliente.",
  },
];
---

<MainLayout title={title} description={description} ogImage={heroImageMeta?.src} monolingual>
  <main>
    <HeroService title={h1} subtitle={subtitle} image={heroImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        "name": h1,
        "serviceType": "Limpieza de cristales",
        "description": description,
        "provider": {
          "@type": "LocalBusiness",
          "@id": `${siteUrl}/#localbusiness`,
        },
        "areaServed": {
          "@type": "City",
          "name": "Benidorm",
          "containedInPlace": { "@type": "AdministrativeArea", "name": "Alicante" },
        },
        "url": pageUrl,
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/` },
          { "@type": "ListItem", "position": 2, "name": "Servicios", "item": `${siteUrl}/servicios/` },
          { "@type": "ListItem", "position": 3, "name": h1, "item": pageUrl },
        ],
      })}
    />

    <Breadcrumb crumbs={[
      { name: "Inicio", href: "/" },
      { name: "Servicios", href: "/servicios/" },
      { name: h1 },
    ]} />

    <div class="service-content trabajo-content">
      <p>
        Limpiamos <strong>cristales en Benidorm</strong> en hoteles y edificios con
        grandes superficies acristaladas. Fachadas, cerramientos y zonas interiores
        de difícil acceso requieren un método de trabajo distinto al de una ventana
        convencional: estudiamos el acceso, seleccionamos la maquinaria y
        coordinamos la intervención con la actividad del inmueble.
      </p>

      <h2>Fachadas acristaladas y hoteles</h2>
      <p>
        En la <a href="/trabajos/limpieza-cristales-fachada-hotel-benidorm/">fachada del
        Hotel Flamingo Oasis de Benidorm</a> trabajamos sobre grandes cristaleras,
        lucernarios y zonas panorámicas con plataforma elevadora. La planificación
        permitió atender las distintas superficies sin detener la actividad del
        hotel. Para edificios con un uso continuo, también podemos organizar
        limpiezas periódicas adaptadas a las zonas que más se ensucian.
      </p>

      <h2>Cristales en altura y espacios de acceso complejo</h2>
      <p>
        Algunas cristaleras interiores no admiten el acceso con una plataforma
        convencional. En el <a href="/trabajos/limpiezas-en-altura-alicante/">Grand
        Hotel Luxor Terra Mítica</a> utilizamos una grúa araña para llegar a los
        cristales de un hall y otras zonas difíciles. Según el espacio, podemos
        emplear también plataformas articuladas o elevadores de tijera.
      </p>

      <h2>Un servicio ajustado a cada edificio</h2>
      <p>
        El tamaño del vidrio, su ubicación y la posibilidad de acceder con
        maquinaria determinan cómo abordamos cada trabajo. Utilizamos equipos
        profesionales y, cuando procede, limpieza con agua osmotizada para evitar
        marcas de cal. Atendemos tanto intervenciones puntuales como necesidades
        de mantenimiento en Benidorm y localidades cercanas de la Costa Blanca.
      </p>

      <div class="not-prose my-8 flex justify-center">
        <ContactButton link="/contacto/" text="Pedir presupuesto de limpieza de cristales" />
      </div>
    </div>

    <TrabajosCiudad
      city="Benidorm"
      service="limpieza-cristales"
      title="Limpieza de cristales realizada en Benidorm"
    />

    <section class="service-content">
      <p>
        Consulta el <a href="/servicios/limpieza-cristales/">servicio general de
        limpieza de cristales</a> o descubre nuestros
        <a href="/servicios/trabajos-altura/">trabajos en altura</a>. Si también
        necesitas cuidar otras superficies del edificio, realizamos
        <a href="/limpieza-industrial-benidorm/">limpieza industrial en Benidorm</a>.
      </p>
    </section>

    <FaqService faqs={faqs} title="Preguntas frecuentes sobre limpieza de cristales en Benidorm" />
  </main>
</MainLayout>
