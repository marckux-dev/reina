---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import type { ImageMetadata } from "astro";
import { Image } from 'astro:assets';
import MainLayout from "../../layouts/MainLayout.astro";
import HeroService from "../../components/HeroService.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FeaturesService from "../../components/FeaturesService.astro";
import Gallery from "../../components/Gallery.astro";
import ParallaxService from "../../components/ParallaxService.astro";
import FaqService from "../../components/FaqService.astro";
export const getStaticPaths = ( async () => {
  const services = await getCollection('services');
  return services.map( entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const imagesMap = import.meta.glob<ImageMetadata>('../../assets/images/*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' });
const headerImageSrc = typeof data.headerImage === 'string' ? data.headerImage : data.headerImage?.src;
const headerImageMeta = headerImageSrc ? imagesMap[`../../assets/images/${headerImageSrc}`] : undefined;

const relatedTrabajos = (await getCollection('trabajos'))
  .filter(t => t.data.service === entry.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTrabajosImages = import.meta.glob<ImageMetadata>('../../assets/images/**/*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' });
function resolveCover(src: string): ImageMetadata | undefined {
  const s = src.startsWith('/') ? src.slice(1) : src;
  return allTrabajosImages[`../../assets/images/${s}`];
}
---

<MainLayout
  title={ data.title }
  description={ data.description }
  ogImage={ headerImageMeta?.src }
>
  <main>
    <HeroService 
      title={ data.h1} 
      subtitle={ data.subtitle } 
      image={ data.headerImage } 
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `https://reinamultiservicios.es/servicios/${entry.slug}#service`,
        "name": data.h1,
        "description": data.subtitle,
        "provider": {
          "@type": "LocalBusiness",
          "@id": "https://reinamultiservicios.es/#localbusiness"
        },
        "areaServed": {
          "@type": "AdministrativeArea",
          "name": "Alicante"
        },
        "availableChannel": {
          "@type": "ServiceChannel",
          "serviceLocation": {
            "@type": "Place",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "La Nucia",
              "addressRegion": "Alicante",
              "addressCountry": "ES"
            }
          }
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": data.h1,
          "itemListElement": data.features.map(feature => ({
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": feature
            }
          }))
        }
      })}
    >
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://reinamultiservicios.es/",
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Servicios",
            "item": "https://reinamultiservicios.es/servicios",
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": data.h1,
            "item": `https://reinamultiservicios.es/servicios/${entry.slug}`,
          },
        ]
      })}
    >
    </script>

    <Breadcrumb crumbs={[
      { name: 'Inicio', href: '/' },
      { name: 'Servicios', href: '/servicios/' },
      { name: data.h1 },
    ]} />

    <FeaturesService features={ data.features } />
    <Gallery images={ data.gallery } serviceTitle={data.h1}/>
    <section class="service-content">
      <Content />
    </section>
    <ParallaxService
      image={ data.parallaxImage }
      slogan={ data.slogan }
    />

    {relatedTrabajos.length > 0 && (
      <section class="container mx-auto px-4 py-10">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-6">Trabajos realizados</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedTrabajos.map(trabajo => {
            const cover = resolveCover(trabajo.data.coverImage.src);
            return (
              <a href={`/trabajos/${trabajo.slug}/`} class="relative overflow-hidden w-full rounded-xl shadow-sm h-32 lg:h-40 group cursor-pointer block">
                {cover && (
                  <Image
                    src={cover}
                    alt={trabajo.data.coverImage.alt}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 640px) 100vw, 33vw"
                    quality={65}
                    format="webp"
                    loading="lazy"
                    class="kenburns w-full h-full object-cover"
                  />
                )}
                <div class="absolute inset-0 bg-black/60 group-hover:bg-black/10 transition-colors duration-1000"></div>
                <div class="absolute inset-0 p-4 flex flex-col justify-end">
                  <h3 class="text-gray-100 font-bold text-sm">{trabajo.data.h1}</h3>
                  <p class="text-gray-300 text-xs">{trabajo.data.city}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <FaqService faqs={ data.faqs }/>
  </main>
</MainLayout>
