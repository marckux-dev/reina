---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Card from '../components/Card.astro';
import ContactButton from '../components/ContactButton.astro';
import { Image } from 'astro:assets';
import pulidoBenidormImage from '../assets/images/suelo-marmol-efecto-espejo-chalet-benidorm.webp';
import pulidoAlteaImage from '../assets/images/pulido-suelo-marmol-altea/coverImage/src.jpg';
import cristalesBenidormImage from '../assets/images/fachada-hotel-limpieza-cristales.webp';
import industrialBenidormImage from '../assets/images/techo-despues-limpieza-presion-benidorm.webp';
import { getCollection } from 'astro:content';
const services = (await getCollection('services'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
import { homeFaqs } from '../data/homeFaqs.ts'
import FaqService from '../components/FaqService.astro';
import Testimonials from '../components/Testimonials.astro';

const localServices = [
  {
    city: 'Benidorm',
    title: 'Pulido de suelos en Benidorm',
    description: 'Mármol y terrazo en hoteles, comunidades y viviendas.',
    href: '/pulido-suelos-benidorm/',
    image: pulidoBenidormImage,
    alt: 'Suelo de mármol pulido con efecto espejo en un chalet de Benidorm',
  },
  {
    city: 'Altea',
    title: 'Pulido de suelos en Altea',
    description: 'Restauración de mármol, travertino y piedra natural.',
    href: '/pulido-suelos-altea/',
    image: pulidoAlteaImage,
    alt: 'Suelo de mármol travertino restaurado en el casco antiguo de Altea',
  },
  {
    city: 'Benidorm',
    title: 'Limpieza de cristales en Benidorm',
    description: 'Fachadas de hoteles y cristaleras de difícil acceso.',
    href: '/limpieza-cristales-benidorm/',
    image: cristalesBenidormImage,
    alt: 'Fachada acristalada de hotel en Benidorm tras su limpieza',
  },
  {
    city: 'Benidorm',
    title: 'Limpieza industrial en Benidorm',
    description: 'Limpieza técnica de hoteles y naves industriales.',
    href: '/limpieza-industrial-benidorm/',
    image: industrialBenidormImage,
    alt: 'Techo de una nave de Benidorm después de la limpieza a presión',
  },
];
---

<MainLayout 
  title="Limpieza Industrial y Tratamiento de Suelos en Alicante"
  description="Empresa de limpieza industrial, pulidos y tratamientos de superficies en Alicante y Costa Blanca. Más de 30 años de experiencia. Presupuesto gratuito."
>

  <header class="relative h-[90vh] overflow-hidden">
    <HeroSlider
      images={[
        "paneles-solares-limpieza-industrial.webp",
        "tratamiento-suelo-exterior-alicante.webp",
        "suelo-marmol-pulido-recibidor-lujo.webp",
        "suelo-hormigon-pulido-garaje-alicante.webp",
        "limpieza-cristales-edificio-altura.webp",
      ]}
      interval={6000}
    />
    <!-- Oscurecimiento para mejorar contraste -->
    <div
      class="absolute z-1 inset-0 bg-linear-to-t from-black/80 via-black/50 to-transparent"
    ></div>
    <div
      class="absolute inset-0 z-10 flex flex-col items-center justify-center h-full text-center text-neutral-content px-4"
    >
      <h1 class="fade-up text-4xl md:text-6xl font-bold drop-shadow-lg mb-4 flex-col justify-center items-center">
        <span>Servicios Profesionales de Limpieza Industrial,</span> <br/> <span>Pulidos y Cristalizados de Superficies</span>
      </h1>
      <p
        class="fade-up-delay text-lg md:text-2xl max-w-2xl font-semibold text-gray-200 leading-relaxed"
      >
        Expertos en limpieza, mantenimiento integral y
        una amplia gama de tratamientos especializados para todo tipo de superficies.
      </p>
    </div>
  </header>

  <main class="container mx-auto">

    <section
      class="container mx-auto px-6 py-12 leading-relaxed text-lg text-base "
    >
      <h2 class="text-3xl font-bold text-center mt-4 mb-4">
        Bienvenido a Reina Multiservicios Costablanca
      </h2>

      <h3 class="text-2xl font-bold italic text-primary text-center mb-6">
        Profesionales en Alicante con más de 30 años de experiencia.
        Soluciones profesionales de limpieza, mantenimiento, pulidos, cristalizados y tratamientos 
        específicos en todo tipo de superficies.
      </h3>

      <div class="flex justify-center my-8">
        <ContactButton link="/contacto" text="Contacta con Nosotros" />
      </div>

      <p class="mb-4">
        <strong>
          Nuestra experiencia y seriedad nos consolidan como una empresa de referencia en la
          Costa Blanca
        </strong>
      </p>

      <p class="mb-4">
        Contamos con una sólida trayectoria en el sector, lo que nos permite ofrecer un servicio 
        caracterizado por la <strong> calidad y el compromiso en cada trabajo que realizamos</strong>.
        Disponemos de un equipo de profesionales capacitados para dar respuesta a los requerimientos 
        de cada cliente con eficacia y responsabilidad. Utilizamos <strong> maquinaria 
        especializada, productos específicos</strong> para cada necesidad y aplicamos las 
        <strong> normas de seguridad pertinentes para cada proceso de trabajo</strong>. Atendemos a 
        hoteles, comunidades, empresas, particulares y otros sectores del ámbito público y privado.
     </p>
     <p class="mb-4">
        Estamos ubicados en La Nucia (Alicante), cerca de poblaciones turísticas como Benidorm,
        Altea y Calp. Prestamos servicio en toda la Costa Blanca, en la Comunitat Valenciana y 
        también en todo el territorio nacional y a nivel internacional.
      </p>

      <p class="mb-4">
        Con más de 30 años de experiencia en el sector, nos avala la confianza de nuestros clientes 
        y nuestro compromiso con <strong> los más altos estándares de calidad</strong>.
      </p>

    </section>

    <section
      class="mb-8"
    >

      <h2 class="text-3xl font-bold text-center mt-4 mb-4">
        Nuestros Servicios
      </h2>

      <div class="grid
        grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6
        gap-4"
      >
        {
        services.map( service => (
        <Card
          image={ typeof service.data.headerImage === 'string' ? service.data.headerImage : service.data.headerImage.src }
          title={ service.data.navItem }
          href={ `/servicios/${ service.slug }` }
        />
        ))
        }
      </div>

      <div class="flex justify-center my-8">
        <ContactButton link="/contacto" text="Pide presupuesto" />
      </div>


    </section>

    <section class="bg-base-200 rounded-2xl px-6 py-12 mb-8" aria-labelledby="zonas-title">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <p class="text-sm font-bold uppercase tracking-widest text-primary mb-2">Costa Blanca</p>
        <h2 id="zonas-title" class="text-3xl font-bold mb-3">Servicios por zonas</h2>
        <p class="text-base-content/70">
          Descubre cómo trabajamos en Benidorm y Altea, con ejemplos reales de cada servicio.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
        {localServices.map((service) => (
          <a href={service.href} class="card bg-base-100 shadow-sm overflow-hidden group transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            <figure class="h-44 overflow-hidden">
              <Image
                src={service.image}
                alt={service.alt}
                widths={[360, 560]}
                sizes="(max-width: 640px) 100vw, (max-width: 1280px) 50vw, 25vw"
                format="webp"
                quality={65}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </figure>
            <div class="card-body gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-primary">{service.city}</span>
              <h3 class="card-title text-lg leading-snug">{service.title}</h3>
              <p class="text-sm text-base-content/70">{service.description}</p>
              <span class="text-sm font-semibold text-primary mt-2">Ver servicio en la zona →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <Testimonials />

    <FaqService faqs={ homeFaqs }/>

  </main>
</MainLayout>
